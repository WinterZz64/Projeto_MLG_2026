# Exemplo de variáveis para configurar no ambiente de execução ou na hospedagem.
# O app.py não carrega este arquivo automaticamente.
# Nunca coloque a chave secreta real neste arquivo nem a envie ao GitHub.
APP_ENV=production
LITTLE_GARDEN_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_PRIVADA_COM_PELO_MENOS_32_CARACTERES
COOKIE_SECURE=1
